{
  "name": "dolgator",
  "version": "1.0.9",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:localhost": "expo start --localhost",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "adb:reverse": "bash scripts/adb-reverse.sh",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk:local": "expo prebuild --platform android --clean && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "eas-cli": "^22.6.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
